<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- "Only while I'm signed in" (Phase 46d): registered with SMAppService.agent. The app's own program
     runs as a small supervisor that starts Sara's server with the settings in
     ~/Library/Application Support/Sara/service/server.env and writes logs to <data>/logs. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.backstagecoding.sara.server</string>
  <key>BundleProgram</key><string>Contents/MacOS/Sara</string>
  <key>ProgramArguments</key>
  <array>
    <string>Contents/MacOS/Sara</string>
    <string>--run-server</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>AssociatedBundleIdentifiers</key><array><string>com.backstagecoding.sara.desktop</string></array>
</dict>
</plist>
