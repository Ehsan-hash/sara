#include <winres.h>
#include "resource.h"
// The version comes from package.json (CMakeLists.txt).
#ifndef SARA_APP_VERSION
#define SARA_APP_VERSION "0.0.0"
#define SARA_VERSION_COMMAS 0,0,0,0
#endif
IDI_SARA ICON "sara.ico"
1 RT_MANIFEST "sara.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION SARA_VERSION_COMMAS
PRODUCTVERSION SARA_VERSION_COMMAS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Backstage Coding"
      VALUE "FileDescription", "Sara"
      VALUE "FileVersion", SARA_APP_VERSION
      VALUE "ProductName", "Sara"
      VALUE "ProductVersion", SARA_APP_VERSION
      VALUE "OriginalFilename", "Sara.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
