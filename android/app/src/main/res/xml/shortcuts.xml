<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Call Sara" (Phase 26). Can be dragged to the home screen. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="call"
        android:enabled="true"
        android:icon="@drawable/icon"
        android:shortcutShortLabel="@string/shortcut_call"
        android:shortcutLongLabel="@string/shortcut_call_long">
        <intent
            android:action="com.backstagecoding.sara.CALL"
            android:targetPackage="com.backstagecoding.sara"
            android:targetClass="com.backstagecoding.sara.MainActivity" />
    </shortcut>
</shortcuts>
